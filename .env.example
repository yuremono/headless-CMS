# Database
# Local: postgresql://USER:PASSWORD@localhost:5432/DB_NAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/headless_cms"

# Supabase (choose one connection mode; do not commit real credentials)
# Direct (5432) — migrations, prisma db seed, one-off admin tasks
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"
# Pooler (6543) — app runtime / serverless; use transaction mode for Prisma
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# App URLs
APP_URL="http://localhost:3000"
FRONTEND_BASE_URL="http://localhost:3001"

# Demo login (development; override defaults in AdminData)
ADMIN_DEMO_EMAIL="admin@example.com"
ADMIN_DEMO_PASSWORD="replace-with-a-demo-password"

# Auth / API keys (lib/auth — optional; dev falls back to fixed tokens when unset)
CMS_PUBLIC_API_KEY=""
CMS_ADMIN_API_KEY=""
CMS_PREVIEW_TOKEN=""
# CMS_SESSION_TOKEN=""  # optional site-scoped: CMS_*_{SITE_ID_SUFFIX}

# Signed preview tokens (lib/preview/signed-preview-token.ts)
# When set, admin preview links use pt.v1.{payload}.{hmac} (24h TTL).
# Delivery API accepts signed tokens; CMS_PREVIEW_TOKEN and dev preview-dev-token still work in development.
PREVIEW_TOKEN_SECRET="replace-with-a-long-random-string"

# Reserved for future session/JWT signing (Auth.js Phase 3-B)
AUTH_SECRET="replace-with-a-long-random-string"

# Phase 3 production auth (lib/auth/production-config.ts)
# CMS_AUTH_PROVIDER=""            # none | authjs | supabase
# CMS_ENFORCE_ADMIN_LOGIN="false" # true: redirect admin UI without cms_session

# Storage (MVP: local)
STORAGE_PROVIDER="local"
UPLOAD_MAX_BYTES="5242880"

# Cloudflare R2 (STORAGE_PROVIDER=r2 — stub in MVP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
