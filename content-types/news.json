{
  "apiName": "news",
  "label": "お知らせ",
  "type": "collection",
  "description": "ニュースや更新情報を管理するコレクション",
  "listViewFields": ["title", "publishedAt"],
  "fields": [
    { "name": "slug", "label": "スラッグ", "type": "text", "required": true },
    { "name": "title", "label": "タイトル", "type": "text", "required": true },
    { "name": "summary", "label": "要約", "type": "textarea" },
    { "name": "body", "label": "本文", "type": "richText", "required": true },
    { "name": "publishedAt", "label": "公開日", "type": "date" },
    { "name": "coverImage", "label": "カバー画像", "type": "image" },
    {
      "name": "seo",
      "label": "SEO",
      "type": "object",
      "fields": [
        { "name": "title", "label": "SEOタイトル", "type": "text" },
        { "name": "description", "label": "SEO説明", "type": "textarea" },
        { "name": "ogTitle", "label": "OGタイトル", "type": "text" },
        { "name": "ogDescription", "label": "OG説明", "type": "textarea" },
        { "name": "ogImage", "label": "OG画像", "type": "image" },
        { "name": "canonicalUrl", "label": "canonical URL", "type": "url" },
        {
          "name": "noindex",
          "label": "noindex",
          "type": "boolean",
          "defaultValue": false
        }
      ]
    }
  ]
}
